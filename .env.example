# Optional. Live profile fetches need a LinkedIn session.
# Leave blank to run the toy portal and the rest of the API.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=
LINKEDIN_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36
REQUEST_TIMEOUT_SECONDS=20
RATE_LIMIT_PER_MINUTE=4
CACHE_TTL_SECONDS=900

# Toy portal clerk. Defaults work as-is.
LEGACY_PORTAL_USER=clerk
LEGACY_PORTAL_PASSWORD=clerk
